                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "6000" }
              ]
            },
            "description": "Filters hotels with price ≥ 6000.\n\nExpected:\n- Taj Palace @ 7500 ✓\n- Marriott @ 8200 ✓\n- The Leela @ 9200 ✓"
