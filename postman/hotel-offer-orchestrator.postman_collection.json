    {
      "name": "Hotel API",
      "item": [
        {
          "name": "Test 1 — Delhi Hotels (Full List)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" }
              ]
            },
            "description": "Fetches all hotels for Delhi.\n\nExpected behavior:\n- Supplier A and B are called in parallel via Temporal workflow\n- Overlapping hotels (Holtin, Radison, The Leela) are deduplicated\n- Cheapest offer selected per hotel\n\nExpected result:\n- Holtin → Supplier B @ 5340 (cheaper than Supplier A @ 6000)\n- Radison → Supplier A @ 5900 (cheaper than Supplier B @ 6200)\n- Taj Palace → Supplier A only @ 7500\n- Marriott → Supplier B only @ 8200\n- The Leela → Supplier A @ 9200 (tie-breaker: A wins)"
          },
          "response": []
        },
        {
          "name": "Test 2 — Price Filter (minPrice + maxPrice)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=7000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "5000" },
                { "key": "maxPrice", "value": "7000" }
              ]
            },
            "description": "Price filtering performed inside Redis using ZRANGEBYSCORE.\n\nExpected: Only hotels with 5000 ≤ price ≤ 7000\n- Holtin @ 5340 ✓\n- Radison @ 5900 ✓\n- Taj Palace @ 7500 ✗ (above range)\n- Marriott @ 8200 ✗ (above range)"
          },
          "response": []
        },
